    "development": {"type": "object", "required": ["algorithm_version", "fixture_budgets", "seeds", "ranges"], "additionalProperties": false, "properties": {"algorithm_version": {"const": "benchmark_v3_r4_development_stratified_random_0.2"}, "fixture_budgets": {"type": "object"}, "seeds": {"type": "object"}, "ranges": {"type": "object"}}},
    "recipe_freeze": {"type": "object", "required": ["status", "seed", "challenge_factor_order", "challenge_selected_columns", "height_mapping"], "additionalProperties": false, "properties": {"status": {"const": "frozen_before_corrective_execution"}, "seed": {"type": "integer"}, "challenge_factor_order": {"const": ["height", "pitch", "relative_yaw", "traffic_density", "weather", "illumination"]}, "challenge_selected_columns": {"const": ["C2", "C3", "C4", "C5", "C6", "C7"]}, "height_mapping": {"const": {"level1_m": 40.0, "level2_m": 20.0, "level3_m": 100.0}}}},
    "selection": {"type": "object", "required": ["site_count", "anchor_count", "distinct_leakage_group_count", "sites", "coverage_limitations", "split_mutation", "eligibility_mutation", "leakage_group_split"], "additionalProperties": false, "properties": {"site_count": {"const": 4}, "anchor_count": {"const": 4}, "distinct_leakage_group_count": {"const": 4}, "sites": {"type": "array", "minItems": 4, "maxItems": 4}, "coverage_limitations": {"type": "object"}, "split_mutation": {"const": "forbidden"}, "eligibility_mutation": {"const": "forbidden"}, "leakage_group_split": {"const": "forbidden"}}},
    "corrective_plan": {"type": "object", "required": ["height_anchor_ids", "density_anchor_by_lane_count", "pressure_anchor_ids", "expected_image_count", "row_count_formula"], "additionalProperties": false, "properties": {"height_anchor_ids": {"const": ["anchor_31689dad20456924", "anchor_10b297bc6ba22abb", "anchor_b0f005cc6ffea491"]}, "density_anchor_by_lane_count": {"const": {"4": "anchor_b0f005cc6ffea491", "6": "anchor_10b297bc6ba22abb", "8": "anchor_c837c6d0fa98b3e7"}}, "pressure_anchor_ids": {"const": ["anchor_31689dad20456924", "anchor_10b297bc6ba22abb", "anchor_b0f005cc6ffea491"]}, "expected_image_count": {"const": 24}, "row_count_formula": {"type": "string"}}},
    "camera": {"type": "object"}, "traffic": {"type": "object"}, "qa": {"type": "object"}, "rc_height_calibration_path": {"type": "string"}, "runtime": {"type": "object"}, "lifecycle": {"type": "object"}, "limits": {"type": "object"}, "sharding": {"type": "object"}, "output": {"type": "object"}, "labels": {"const": {"official_labels": ["road_mask_visible", "lane_polyline_projected"]}}, "safety_boundaries": {"type": "object"}
