{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarkproject.local/schemas/v3/r4_traffic_topology_layout.schema.json",
  "title": "benchmark_v3 R4 CARLA waypoint traffic topology layout 0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "rule_version", "resolution", "map_ids", "master_layout_seed", "strata_per_lane", "longitudinal_range_m", "vehicle_ground_clearance_m", "anchor_count", "anchors"],
  "properties": {
    "schema_version": {"const": "benchmark_v3_r4_traffic_topology_layout_0.1"},
    "protocol_version": {"const": "V3-PLAN-20260727-R4"},
    "rule_version": {"const": "benchmark_v3_r4_carla_waypoint_lane_topology_0.1"},
    "resolution": {"const": "carla_waypoint_topology_frozen_without_sensor_capture"},
    "map_ids": {"type": "array", "const": ["Town04_Opt", "Town05_Opt", "Town10HD_Opt"]},
    "master_layout_seed": {"type": "integer"},
    "strata_per_lane": {"type": "integer", "const": 8},
    "longitudinal_range_m": {"type": "array", "const": [-95.0, 95.0]},
    "vehicle_ground_clearance_m": {"const": 0.5},
    "anchor_count": {"const": 4},
    "anchors": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "site_id", "map_id", "road_id", "section_id", "anchor_s_m", "corridor_s_direction", "lane_ids", "actors", "qa"],
      "properties": {
        "anchor_id": {"type": "string"}, "site_id": {"type": "string"}, "map_id": {"type": "string"},
        "road_id": {"type": "integer"}, "section_id": {"type": "integer"}, "anchor_s_m": {"type": "number"}, "lane_count": {"type": "integer", "minimum": 1},
        "corridor_s_direction": {"type": "integer", "enum": [-1, 1]}, "lane_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "actors": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["actor_id", "logical_lane_index", "master_ordinal", "longitudinal_offset_m", "transform", "frozen_lane_id", "waypoint_road_id", "waypoint_section_id", "waypoint_s_m"], "properties": {"actor_id": {"type": "string"}, "logical_lane_index": {"type": "integer", "minimum": 0}, "master_ordinal": {"type": "integer", "minimum": 0}, "longitudinal_offset_m": {"type": "number"}, "transform": {"type": "object"}, "frozen_lane_id": {"type": "integer"}, "waypoint_road_id": {"type": "integer"}, "waypoint_section_id": {"type": "integer"}, "waypoint_s_m": {"type": "number"}}, "additionalProperties": true}},
        "qa": {"type": "object"}, "master_layout_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  }
}
