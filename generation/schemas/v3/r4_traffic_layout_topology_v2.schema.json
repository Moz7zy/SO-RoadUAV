{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarkproject.local/schemas/v3/r4_traffic_layout_topology_v2.schema.json",
  "title": "benchmark_v3 R4 CARLA waypoint traffic master layout 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "rule_version", "anchor_id", "map_id", "site_id", "lane_count", "master_layout_seed", "master_density", "actors", "qa", "master_layout_hash"],
  "properties": {
    "schema_version": {"const": "benchmark_v3_r4_traffic_layout_topology_v2_0.1"},
    "protocol_version": {"const": "V3-PLAN-20260727-R4"},
    "rule_version": {"const": "benchmark_v3_r4_carla_waypoint_seeded_lane_jitter_master_subset_0.2"},
    "anchor_id": {"type": "string"},
    "map_id": {"type": "string"},
    "site_id": {"type": "string"},
    "lane_count": {"type": "integer", "minimum": 1},
    "master_layout_seed": {"type": "integer"},
    "master_density": {"const": 40.0},
    "layout_attempt": {"type": "integer", "minimum": 0},
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "vehicle_blueprint_id", "master_ordinal", "logical_lane_index", "lane_id", "frozen_lane_id", "longitudinal_offset_m", "lateral_offset_m", "transform", "waypoint_road_id", "waypoint_section_id", "waypoint_s_m", "control"],
        "properties": {
          "actor_id": {"type": "string"},
          "carla_actor_id": {"type": ["integer", "null"]},
          "vehicle_blueprint_id": {"const": "vehicle.tesla.model3"},
          "master_ordinal": {"type": "integer", "minimum": 0},
          "logical_lane_index": {"type": "integer", "minimum": 0},
          "lane_id": {"type": "string"},
          "frozen_lane_id": {"type": "integer"},
          "longitudinal_offset_m": {"type": "number"},
          "lateral_offset_m": {"type": "number"},
          "transform": {
            "type": "object",
            "required": ["frame", "lane_id", "location", "rotation"],
            "properties": {
              "frame": {"const": "carla_unreal_frozen_waypoint_r4_v2"},
              "lane_id": {"type": "integer"},
              "location": {"type": "object", "required": ["x", "y", "z"], "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}},
              "rotation": {"type": "object", "required": ["pitch", "yaw", "roll"], "additionalProperties": false, "properties": {"pitch": {"type": "number"}, "yaw": {"type": "number"}, "roll": {"type": "number"}}}
            },
            "additionalProperties": false
          },
          "waypoint_road_id": {"type": "integer"},
          "waypoint_section_id": {"type": "integer"},
          "waypoint_s_m": {"type": "number"},
          "control": {"const": "fixed_transform_no_autopilot"},
          "topology_rule_version": {"const": "benchmark_v3_r4_carla_waypoint_lane_topology_0.1"}
        }
      }
    },
    "qa": {"type": "object"},
    "master_layout_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
