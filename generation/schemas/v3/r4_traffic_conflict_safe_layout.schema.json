{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarkproject.local/schemas/v3/r4_traffic_conflict_safe_layout.schema.json",
  "title": "benchmark_v3 R4 conflict-safe traffic topology layout 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "rule_version", "resolution", "map_ids", "master_layout_seed", "strata_per_lane", "longitudinal_range_m", "vehicle_ground_clearance_m", "anchor_count", "conflict_exclusion", "anchors"],
  "properties": {
  "schema_version": {"const": "benchmark_v3_r4_conflict_safe_traffic_layout_0.2"},
    "protocol_version": {"const": "V3-PLAN-20260727-R4"},
  "rule_version": {"const": "benchmark_v3_r4_carla_conflict_safe_master_layout_0.2"},
    "resolution": {"const": "carla_waypoint_conflict_exclusion_frozen_without_sensor_capture"},
    "map_ids": {"const": ["Town04_Opt", "Town05_Opt", "Town10HD_Opt"]},
    "master_layout_seed": {"type": "integer"},
    "strata_per_lane": {"const": 8},
    "longitudinal_range_m": {"const": [-95.0, 95.0]},
    "vehicle_ground_clearance_m": {"const": 0.5},
    "anchor_count": {"const": 4},
    "conflict_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version", "is_junction_hard_reject", "conflict_zone_radius_m", "topology_rule_version", "anchor_checksum_rule"],
      "properties": {
        "rule_version": {"const": "benchmark_v3_r4_conflict_exclusion_junction_radius_0.1"},
        "is_junction_hard_reject": {"const": true},
        "conflict_zone_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "topology_rule_version": {"const": "benchmark_v3_r4_carla_conflict_safe_master_layout_0.2"},
        "anchor_checksum_rule": {"type": "string"}
      }
    },
    "anchors": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anchor_id", "site_id", "map_id", "road_id", "section_id", "anchor_s_m", "corridor_s_direction", "lane_ids", "lane_count", "conflict_exclusion", "candidate_audit", "actors", "qa", "master_layout_hash"],
        "properties": {
          "anchor_id": {"type": "string"}, "site_id": {"type": "string"}, "map_id": {"type": "string"},
          "road_id": {"type": "integer"}, "section_id": {"type": "integer"}, "anchor_s_m": {"type": "number"},
          "corridor_s_direction": {"type": "integer", "enum": [-1, 1]}, "lane_count": {"type": "integer", "minimum": 1},
          "lane_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
          "conflict_exclusion": {"type": "object", "required": ["rule_version", "is_junction_hard_reject", "conflict_zone_radius_m", "candidate_audit_fields", "checksum_scope"], "additionalProperties": false, "properties": {"rule_version": {"const": "benchmark_v3_r4_conflict_exclusion_junction_radius_0.1"}, "is_junction_hard_reject": {"const": true}, "conflict_zone_radius_m": {"type": "number"}, "candidate_pool_rule": {"type": "string"}, "candidate_audit_fields": {"type": "array", "items": {"type": "string"}}, "checksum_scope": {"type": "string"}}},
          "candidate_audit": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["candidate_index", "lane_index", "longitudinal_offset_m", "direction", "accepted", "rejection_reasons", "nearest_junction_distance_m", "nearest_junction_identity", "waypoint_identity", "transform"], "properties": {"candidate_index": {"type": "integer"}, "lane_index": {"type": "integer"}, "longitudinal_offset_m": {"type": "number"}, "direction": {"enum": ["next", "previous"]}, "accepted": {"type": "boolean"}, "rejection_reasons": {"type": "array", "items": {"type": "string"}}, "nearest_junction_distance_m": {"type": ["number", "null"]}, "nearest_junction_identity": {"type": ["object", "null"]}, "waypoint_identity": {"type": ["object", "null"]}, "transform": {"type": ["object", "null"]}}}},
          "actors": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["actor_id", "vehicle_blueprint_id", "master_ordinal", "logical_lane_index", "lane_id", "frozen_lane_id", "longitudinal_offset_m", "lateral_offset_m", "transform", "waypoint_road_id", "waypoint_section_id", "waypoint_s_m", "control", "topology_rule_version", "conflict_exclusion_rule_version"], "properties": {"actor_id": {"type": "string"}, "vehicle_blueprint_id": {"const": "vehicle.tesla.model3"}, "master_ordinal": {"type": "integer"}, "logical_lane_index": {"type": "integer"}, "lane_id": {"type": "string"}, "frozen_lane_id": {"type": "integer"}, "longitudinal_offset_m": {"type": "number"}, "lateral_offset_m": {"type": "number"}, "transform": {"type": "object"}, "waypoint_road_id": {"type": "integer"}, "waypoint_section_id": {"type": "integer"}, "waypoint_s_m": {"type": "number"}, "control": {"const": "fixed_transform_no_autopilot"}, "topology_rule_version": {"const": "benchmark_v3_r4_carla_conflict_safe_master_layout_0.2"}, "conflict_exclusion_rule_version": {"const": "benchmark_v3_r4_conflict_exclusion_junction_radius_0.1"}}}},
          "qa": {"type": "object"},
          "master_layout_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
