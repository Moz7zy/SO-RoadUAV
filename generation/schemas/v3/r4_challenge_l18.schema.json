{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmarkproject.local/schemas/v3/r4_challenge_l18.schema.json",
  "title": "benchmark_v3 R4 Challenge L18 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "design", "status", "recipe_rule_version", "selected_three_level_columns", "factor_order", "factor_level_values", "rows"],
  "properties": {
    "schema_version": {"const": "benchmark_v3_challenge_l18_r4_0.1"},
    "protocol_version": {"const": "V3-PLAN-20260727-R4"},
    "design": {"const": "L18(2^1x3^7)"},
    "status": {"type": "string"},
    "recipe_rule_version": {"const": "benchmark_v3_r4_challenge_l18_0.1"},
    "selected_three_level_columns": {"const": ["C2", "C3", "C4", "C5", "C6", "C7"]},
    "factor_order": {"const": ["height", "pitch", "relative_yaw", "traffic_density", "weather", "illumination"]},
    "factor_level_values": {
      "type": "object", "additionalProperties": false,
      "required": ["height", "pitch", "relative_yaw", "traffic_density", "weather", "illumination"],
      "properties": {
        "height": {"const": {"1": 40.0, "2": 20.0, "3": 100.0}},
        "pitch": {"const": {"1": -80.0, "2": -90.0, "3": -70.0}},
        "relative_yaw": {"const": {"1": 0.0, "2": -15.0, "3": 15.0}},
        "traffic_density": {"const": {"1": 0.0, "2": 20.0, "3": 40.0}},
        "weather": {"const": {"1": "dry", "2": "rain-wet", "3": "fog"}},
        "illumination": {"const": {"1": 75.0, "2": 15.0, "3": -5.0}}
      }
    },
    "rows": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["challenge_row_id", "levels"],
        "properties": {
          "challenge_row_id": {"type": "string", "pattern": "^L18_R[0-9]{2}$"},
          "levels": {
            "type": "object", "additionalProperties": false,
            "required": ["height", "pitch", "relative_yaw", "traffic_density", "weather", "illumination"],
            "properties": {
              "height": {"enum": [1, 2, 3]}, "pitch": {"enum": [1, 2, 3]}, "relative_yaw": {"enum": [1, 2, 3]},
              "traffic_density": {"enum": [1, 2, 3]}, "weather": {"enum": [1, 2, 3]}, "illumination": {"enum": [1, 2, 3]}
            }
          }
        }
      }
    }
  }
}
